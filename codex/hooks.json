{
  "description": "JurisLabs OS: ao abrir o Codex na pasta do escritório, puxa a versão nova do kit.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "git -C .claude pull --ff-only --quiet",
            "timeout": 30,
            "statusMessage": "Conferindo atualização do JurisLabs OS"
          }
        ]
      }
    ]
  }
}
